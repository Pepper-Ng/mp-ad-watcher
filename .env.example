# Copy this file to .env and fill in your values.

# Use the Marktplaats search JSON endpoint. In the browser developer tools Network tab,
# filter for lrp/api/search while loading a Marktplaats search result page.
MARKTPLAATS_SEARCH_URL=https://www.marktplaats.nl/lrp/api/search?limit=30&offset=0&query=example&postcode=1234AB&distanceMeters=10000&searchInTitleAndDescription=true

# Describe what makes an ad worth notifying you about.
MARKTPLAATS_USE_CASE=Describe the item you want, the required characteristics, acceptable trade-offs, and clear reasons to reject an ad. Use notify for clear matches, review for plausible matches with missing details, and ignore only for clear mismatches.

# First run default: mark the current search result set as seen without evaluating it.
BOOTSTRAP_EXISTING_ADS=true
EXCLUDE_ADMARKT_ADS=true
POLL_INTERVAL_SECONDS=600
MAX_ADS_PER_POLL=30
NOTIFY_MIN_CONFIDENCE=0.65
REVIEW_MIN_CONFIDENCE=0
NOTIFY_REVIEW_ACTIONS=true

# Provider presets: deepseek, openai, gemini, anthropic, or openai-compatible.
# DeepSeek and Gemini use OpenAI-compatible Chat Completions. OpenAI uses its native
# Responses API, and Anthropic uses its native Messages API.
MODEL_PROVIDER=deepseek
MODEL_API_KEY=replace-me
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-v4-flash
MODEL_TEMPERATURE=0
MODEL_MAX_TOKENS=700
MODEL_REASONING_EFFORT=
MODEL_JSON_MODE=true

# Leave image content disabled for text-only models. Provider presets translate image URLs
# to the correct OpenAI-compatible, OpenAI Responses, or Anthropic Messages content shape.
SEND_IMAGE_CONTENT_TO_MODEL=false
MAX_IMAGES_FOR_MODEL=3

# Optional Telegram notification. Leave empty to only write evaluation JSONL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DISABLE_WEB_PAGE_PREVIEW=false

STATE_FILE=data/seen_ads.json
RESULTS_FILE=data/evaluations.jsonl
STATUS_FILE=data/runtime_status.json
REQUEST_TIMEOUT_SECONDS=20
USER_AGENT=marktplaats-ad-watcher/0.1 (+local personal watcher)

# Protects the tiny web UI. Set this before exposing the Docker port.
WEB_ADMIN_TOKEN=replace-me
